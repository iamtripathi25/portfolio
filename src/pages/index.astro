---
import ProjectComponent from '../components/ProjectComponent';
import Layout from '../layouts/Layout.astro'
import ContactPage from '../components/ContactPage'
import WorkCard from '../components/WorkCard';
import Achievements from '../components/Achievements';

import Home from '../components/Home'
import { BlogData } from '../data/BlogData'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const latestPost = [...BlogData].sort((a, b) => new Date(b.date) - new Date(a.date))[0]

// Only the fields the hero needs — keeps post bodies out of the client bundle.
const latestNote = latestPost && {
  title: latestPost.title,
  readingTime: latestPost.readingTime,
  href: `${base}/blog/${latestPost.slug}/`,
}
---
<Layout
    title="Aman Tripathi | Backend & Cloud Engineer"
    description="Aman Tripathi is a backend and cloud engineer building serverless APIs, event-driven data pipelines, and secure multi-tenant platforms on AWS."
    path="/"
>
    <Home client:visible latestNote={latestNote}/>
    <WorkCard client:visible/>

        <div id="project" class="font-Manrope pt-28 md:pt-36">
            <div class="mb-12 grid w-full gap-8 px-6 md:px-10 lg:grid-cols-[0.8fr_1fr] lg:items-end">
                <div>
                    <h1 class="text-5xl font-semibold leading-none tracking-tight text-[#F2613F] sm:text-6xl lg:text-8xl">Projects.</h1>
                </div>
                <div class="max-w-2xl lg:ml-auto">
                    <p class="text-base font-medium leading-8 text-neutral-300 md:text-lg">
                        A focused collection of backend systems, product interfaces, and full-stack experiments built around practical engineering problems.
                    </p>
                    <a class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-neutral-100 underline decoration-[#F2613F] underline-offset-4 transition-colors duration-300 hover:text-[#F2613F]" href="https://github.com/iamtripathi25?tab=repositories" target="_blank" rel="noreferrer">
                        View all repositories
                        <span>-&gt;</span>
                    </a>
                </div>
            </div>
            <ProjectComponent client:visible/>
        </div>

    <Achievements client:visible/>

    <div id="contact" class="mt-[4vh]">
            <ContactPage client:visible/>
    </div>
  

    
</Layout>
