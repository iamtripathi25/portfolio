---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Learning Tracks | Aman Tripathi">
  <section class="font-Manrope mx-auto grid min-h-[calc(100vh-4.5rem)] max-w-7xl content-center px-6 py-20 md:px-10 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1fr] lg:items-end">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase text-[#F2613F]">Learning</p>
        <h1 class="text-5xl font-semibold leading-none tracking-tight text-neutral-100 sm:text-6xl lg:text-8xl">
          Tracks.
        </h1>
      </div>

      <p class="max-w-3xl text-lg font-semibold leading-9 text-neutral-200 md:text-2xl md:leading-10 lg:ml-auto">
        A living place for what I am learning, grouped by track so each area has its own direction, notes, and progress.
      </p>
    </div>
  </section>

</Layout>
