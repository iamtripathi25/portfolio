---
import { Code } from 'astro/components'
import Layout from '../../layouts/Layout.astro'
import ShareLink from '../../components/ShareLink'
import { BlogData } from '../../data/BlogData'

export function getStaticPaths() {
  return BlogData.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const formatDate = (value) =>
  new Date(value).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })

// Size the headline from its own length so it stays on one line across the full column.
// 118rem ÷ length approximates Manrope's average advance width; capped so short titles stay sane.
const titleSize = Math.min(4.5, 118 / post.title.length).toFixed(2)

// Change this to route feedback somewhere else.
const feedbackEmail = 'iamtripathi.25@gmail.com'

const postUrl = new URL(`${base}/blog/${post.slug}/`, Astro.site).href
const feedbackSubject = `Feedback: ${post.title}`
const feedbackBody = `Hi Aman,\n\nThoughts on "${post.title}":\n\n\n---\nRead at: ${postUrl}`
const feedbackHref = `mailto:${feedbackEmail}?subject=${encodeURIComponent(
  feedbackSubject
)}&body=${encodeURIComponent(feedbackBody)}`

const slugify = (text) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')

const sections = post.body.filter((block) => block.type === 'h2').map((block) => ({
  id: slugify(block.text),
  text: block.text,
}))

// The right column only earns its space when there is something to put in it.
const hasSidebar = sections.length > 1 || post.references?.length > 0

const wordCount = post.body
  .map((block) => (block.type === 'code' ? block.caption ?? '' : block.text))
  .join(' ')
  .split(/\s+/)
  .filter(Boolean).length

const others = BlogData.filter((item) => item.slug !== post.slug)
  .sort((a, b) => new Date(b.date) - new Date(a.date))
  .slice(0, 2)
---

<Layout title={`${post.title} | Aman Tripathi`} description={post.excerpt} path={`/blog/${post.slug}/`}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.date} />
    <meta property="article:section" content={post.category} />
    <meta property="article:author" content="Aman Tripathi" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.excerpt,
      datePublished: post.date,
      dateModified: post.date,
      articleSection: post.category,
      wordCount,
      inLanguage: 'en',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Aman Tripathi' },
      publisher: { '@type': 'Person', name: 'Aman Tripathi' },
      url: postUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
      isPartOf: {
        '@type': 'Blog',
        name: 'Journal — Aman Tripathi',
        url: new URL(`${base}/blog/`, Astro.site).href,
      },
    })} />
  </Fragment>

  <article class="font-Manrope mx-auto max-w-7xl px-6 py-14 md:px-10 md:py-20">
    <div class="lg:mx-auto lg:w-[91.666667%] lg:pl-[9.0909%]">
      <a
        href={`${base}/blog/`}
        class="text-sm font-semibold uppercase tracking-[0.28em] text-[#F2613F] transition-opacity duration-300 hover:opacity-70"
      >
        &larr; Journal
      </a>

      <h1
        class="mt-8 text-[clamp(2.4rem,7vw,3.4rem)] font-semibold leading-[1.05] tracking-tight text-neutral-100 lg:whitespace-nowrap lg:text-[length:var(--title-size)]"
        style={`--title-size: ${titleSize}rem`}
      >
        {post.title}
      </h1>

      <div class="mt-8 flex items-center justify-between gap-x-6 border-b border-neutral-800 pb-8">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold uppercase tracking-[0.18em] text-neutral-500">
          <span class="text-neutral-400">{post.category}</span>
          <span aria-hidden="true">/</span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          <span aria-hidden="true">/</span>
          <span>{post.readingTime}</span>
        </div>

        <ShareLink client:idle url={postUrl} title={post.title} />
      </div>

      <div class={hasSidebar ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-x-12' : ''}>
      <div class="mt-12 max-w-3xl">
        {
          post.body.map((block) => {
            if (block.type === 'h2') {
              return (
                <h2
                  id={slugify(block.text)}
                  class="mb-5 mt-14 scroll-mt-12 text-2xl font-semibold leading-snug text-neutral-100 md:text-3xl"
                >
                  {block.text}
                </h2>
              )
            }

            if (block.type === 'code') {
              return (
                <figure class="my-10">
                  <div class="overflow-hidden rounded-lg border border-neutral-800 bg-[#101010]">
                    <div class="flex items-center justify-between gap-4 border-b border-neutral-800 px-4 py-3">
                      <span class="truncate font-mono text-xs text-neutral-400">
                        {block.filename ?? block.lang}
                      </span>
                      <span class="shrink-0 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-neutral-600">
                        {block.lang}
                      </span>
                    </div>

                    <div class="code-block overflow-x-auto p-4">
                      <Code code={block.code.trim()} lang={block.lang} theme="github-dark" />
                    </div>
                  </div>

                  {block.caption && (
                    <figcaption class="mt-4 text-sm leading-7 text-neutral-500">{block.caption}</figcaption>
                  )}
                </figure>
              )
            }

            if (block.type === 'quote') {
              return (
                <blockquote class="my-12 border-l-2 border-[#F2613F] pl-6 text-xl font-semibold leading-9 text-neutral-200 md:text-2xl md:leading-10">
                  {block.text}
                </blockquote>
              )
            }

            return <p class="mb-7 text-base leading-8 text-neutral-300 md:text-lg md:leading-9">{block.text}</p>
          })
        }
      </div>

      {hasSidebar && (
      <aside class="mt-16 lg:mt-12">
        <div class="lg:sticky lg:top-12">
          {sections.length > 1 && (
            <nav aria-label="Contents" class="hidden lg:block">
              <p class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-500">Contents</p>

              <ul class="mt-5 grid gap-3 border-l border-neutral-800 pl-4">
                {sections.map((section) => (
                  <li>
                    <a
                      href={`#${section.id}`}
                      class="text-sm leading-6 text-neutral-400 transition-colors duration-300 hover:text-[#F2613F]"
                    >
                      {section.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {post.references?.length > 0 && (
            <div class={sections.length > 1 ? 'border-t border-neutral-800 pt-8 lg:mt-10' : ''}>
              <p class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-500">References</p>

              <ol class="mt-5 grid gap-5">
                {post.references.map((reference, index) => (
                  <li class="grid grid-cols-[auto_1fr] gap-3">
                    <span class="pt-0.5 text-xs font-semibold tabular-nums text-[#F2613F]">
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <div>
                      <a
                        href={reference.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm font-semibold leading-6 text-neutral-300 underline decoration-neutral-700 underline-offset-4 transition-colors duration-300 hover:text-[#F2613F] hover:decoration-[#F2613F]"
                      >
                        {reference.label}
                      </a>

                      {reference.note && (
                        <p class="mt-2 text-xs leading-6 text-neutral-500">{reference.note}</p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </aside>
      )}
      </div>

      {
        others.length > 0 && (
          <div class="mt-24 border-t border-neutral-800 pt-10">
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-neutral-500">Keep reading</p>

            <ul class="mt-8 grid gap-8 md:grid-cols-2">
              {others.map((item) => (
                <li>
                  <a href={`${base}/blog/${item.slug}/`} class="group block">
                    <span class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-500">
                      {item.category}
                    </span>
                    <h3 class="mt-3 text-xl font-semibold leading-snug text-neutral-100 transition-colors duration-300 group-hover:text-[#F2613F] md:text-2xl">
                      {item.title}
                    </h3>
                    <p class="mt-3 text-base leading-7 text-neutral-400">{item.excerpt}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <!-- Sticks to the bottom of the viewport while the entry scrolls, then settles here. -->
      <div class="sticky bottom-0 mt-20 border-t-2 border-[#F2613F] bg-[#0C0C0C]/90 px-5 py-4 backdrop-blur-md">
        <p class="text-sm leading-7 text-neutral-400">
          Thoughts, or something I got wrong?{' '}
          <a
            href={feedbackHref}
            class="text-neutral-200 underline decoration-neutral-700 underline-offset-4 transition-colors duration-300 hover:text-[#F2613F] hover:decoration-[#F2613F]"
          >
            Send me a note
          </a>
          .
        </p>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Shiki renders its own <pre> with an inline background; let the panel show through. */
  .code-block :global(pre.astro-code) {
    margin: 0;
    background-color: transparent !important;
  }

  .code-block :global(pre.astro-code code) {
    font-size: 0.875rem;
    line-height: 1.75;
  }
</style>
