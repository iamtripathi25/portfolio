---
import Navbar from "../components/Navbar";
import "../css/global.css";

// `description` and `path` are optional — pages that pass them get the full
// search/social metadata block; pages that don't are left exactly as before.
const { title = "Aman Tripathi", description, path } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = path ? new URL(`${base.replace(/\/$/, '')}${path}`, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#0C0C0C] text-neutral-100">


	<head>
		<link rel="icon"  href={`${base}favico.svg`}>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

		<meta name="google-site-verification" content="iBb-mCyn03Va6FTLF-3fU3SncOH7L1vYDy5k0PBoXkM" />
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>

	{description && <meta name="description" content={description} />}
	{canonical && <link rel="canonical" href={canonical} />}

	{description && <meta name="author" content="Aman Tripathi" />}
	{description && <meta property="og:site_name" content="Aman Tripathi" />}
	{description && <meta property="og:title" content={title} />}
	{description && <meta property="og:description" content={description} />}
	{description && canonical && <meta property="og:url" content={canonical} />}
	{description && <meta name="twitter:card" content="summary_large_image" />}
	{description && <meta name="twitter:title" content={title} />}
	{description && <meta name="twitter:description" content={description} />}

	<slot name="head" />
</head>
<body class="min-h-screen bg-[#0C0C0C] text-neutral-100">
	<!--Navbar -->
	<Navbar client:visible/>
	<main>
		<slot/>
	</main>
	<!-- <Footer/> -->
</body>
</html>
